# Serves the SPA and proxies /api to the Spring backend on the internal docker network,
# so browser and API share one origin (needed by the SameSite=Strict session cookie).
# TLS is terminated in front of this container by Nginx Proxy Manager on another host.
# Processed by envsubst at container startup (FT_* variables only).

# Only the reverse proxy at FT_TRUSTED_PROXY may tell us the client's scheme. NPM talks
# to us over plain HTTP, so $scheme alone would always be "http".
geo $realip_remote_addr $from_trusted_proxy {
    default 0;
    ${FT_TRUSTED_PROXY} 1;
}

map "$from_trusted_proxy:$http_x_forwarded_proto" $forwarded_proto {
    ~^1:(https|http)$ $1;
    default           $scheme;
}

# Throttle the endpoints reachable without a session, per client IP (resolved by real_ip below):
# password and 2FA guessing, and session creation (each CSRF fetch stores a session row).
# The backend also locks accounts and limits failures per IP; this caps the raw request rate.
limit_req_zone $binary_remote_addr zone=ft_auth:1m rate=10r/m;
limit_req_zone $binary_remote_addr zone=ft_session:1m rate=60r/m;
limit_req_status 429;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    client_max_body_size 1m;

    # NPM connects from its own address: take the client IP from the X-Forwarded-For it
    # sends, and only from it. Anyone else reaching the port directly keeps their own IP.
    set_real_ip_from ${FT_TRUSTED_PROXY};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # Security headers for the SPA
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;

    location /api/ {
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Send only the client IP resolved above: appending the client-supplied chain would
        # let Tomcat trust forged private addresses and dodge the per-IP login limit.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        proxy_read_timeout 60s;

        # proxy_pass is not inherited by nested locations; the headers above are
        location = /api/auth/login {
            limit_req zone=ft_auth burst=10 nodelay;
            proxy_pass http://backend:8080;
        }
        location = /api/auth/login/mfa {
            limit_req zone=ft_auth burst=10 nodelay;
            proxy_pass http://backend:8080;
        }
        location = /api/auth/csrf {
            limit_req zone=ft_session burst=30 nodelay;
            proxy_pass http://backend:8080;
        }
        # Same JSON shape as the backend, so the SPA shows its "too many attempts" message
        error_page 429 = @too_many_requests;
    }

    location @too_many_requests {
        default_type application/problem+json;
        return 429 '{"status":429,"title":"Too Many Requests","code":"too_many_attempts"}';
    }

    # Actuator is internal only
    location /actuator/ {
        return 404;
    }

    # Hashed assets: cache forever
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # SPA routes
    location / {
        add_header Cache-Control "no-cache";
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        try_files $uri /index.html;
    }
}
