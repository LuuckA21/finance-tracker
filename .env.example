# Copy to .env and fill in. Never commit .env.

# Database password (any long random string): openssl rand -base64 24
DB_PASSWORD=

# 32-byte key that encrypts 2FA secrets at rest: openssl rand -base64 32
# Keep a backup: if it is lost, users with 2FA must have it reset by an admin.
APP_ENCRYPTION_KEY=

# First administrator, created only when the database is empty.
# Leave the password empty to have a random one printed once in the backend log.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=
# Language of the first administrator (IT or EN): interface and starting categories.
APP_ADMIN_LANGUAGE=IT

# Where the web container listens: the LAN IP of this server, reached by Nginx Proxy Manager
WEB_BIND=192.168.1.20
WEB_PORT=8088
# IP (or CIDR) of the host running Nginx Proxy Manager. Only its X-Forwarded-For/-Proto are
# trusted, so the login rate limit sees the real client IP. Never 0.0.0.0/0.
TRUSTED_PROXY=192.168.1.10/32

# Keep true in production (HTTPS). Set false only for plain-http local testing.
SESSION_COOKIE_SECURE=true
SESSION_TIMEOUT=2h
TZ=Europe/Zurich
